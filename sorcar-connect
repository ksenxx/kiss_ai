#!/bin/bash
# Author: Koushik Sen (ksen@berkeley.edu)
# Contributors:
# Koushik Sen (ksen@berkeley.edu)
# add your name here
#
# Open the KISS Sorcar IDE that ``sorcar-cloud`` already deployed on a remote
# host — from ANY machine that can SSH into that host.
#
# This script deploys nothing and copies nothing.  It asks the remote host
# which ports its IDE uses, makes sure the IDE is running, forwards the ports
# over SSH and opens your browser.  It needs only ``bash`` and ``ssh``, so it
# runs on a laptop that has never seen this repository: copy this ONE file
# (``scp user@host:kiss/sorcar-connect .``) and run it.
#
# Usage:  ./sorcar-connect [--print] [--no-browser] user@ip-address [PORT]
#
#   --print       Print the plain ``ssh -L ...`` command (and the VS Code
#                 Remote-SSH command) for this host and exit, instead of
#                 opening the tunnel.  Use it when you would rather run ssh
#                 yourself, or on a machine without a browser.
#   --no-browser  Open the tunnel and hold it, but do not launch a browser.
#   PORT          Remote IDE port.  Default: whatever the last deploy
#                 recorded in ~/.kiss/sorcar-cloud.env on the host (8080 if
#                 that file is missing).
#
# Flow:
#   1. SSH connectivity check.
#   2. Ask the remote host for its deployment facts — IDE port, webapp port,
#      workspace path, IDE service name — from ~/.kiss/sorcar-cloud.env,
#      which sorcar-cloud writes on every deploy.
#   3. Make sure the IDE is up: start its systemd *user* service if it is not
#      running, then wait for code-server's /healthz to answer on the remote
#      loopback.  (The IDE binds 127.0.0.1 only, which is what keeps an
#      unauthenticated editor off the public internet — the SSH tunnel below
#      is the only way in.)
#   4. Forward two local ports to it: the IDE, and the kiss-web webapp.  A
#      local port that is already busy is skipped in favour of a free one, so
#      several of these can run side by side.
#   5. Open the browser at the IDE, wait for the webapp, then hold the tunnel
#      until Ctrl+C.  Closing the tunnel leaves the remote IDE running for
#      the next machine that connects.
set -euo pipefail

info() { printf '\033[0;32m[INFO]\033[0m  %s\n' "$*"; }
step() { printf '\033[0;34m[STEP]\033[0m  %s\n' "$*"; }
warn() { printf '\033[1;33m[WARN]\033[0m  %s\n' "$*"; }
die()  { printf '\033[0;31m[ERR]\033[0m  %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# 1. Arguments
# ---------------------------------------------------------------------------
PRINT_ONLY=0
OPEN_BROWSER=1
ARGS=()
for arg in "$@"; do
    case "$arg" in
        --print) PRINT_ONLY=1 ;;
        --no-browser) OPEN_BROWSER=0 ;;
        -h|--help)
            # Print the header comment block: everything from line 2 up to
            # (but not including) the first non-comment line.
            awk 'NR>1 && /^[^#]/{exit} NR>1{sub(/^# ?/, ""); print}' "$0"
            exit 0 ;;
        *) ARGS+=("$arg") ;;
    esac
done
TARGET="${ARGS[0]:-}"
WANT_PORT="${ARGS[1]:-}"

[[ -n "$TARGET" ]] || die "Usage: $0 [--print] [--no-browser] user@ip-address [PORT]"
[[ "$TARGET" == *"@"* ]] || warn "TARGET '$TARGET' has no 'user@' part; using the SSH default user."
if [[ -n "$WANT_PORT" ]]; then
    # The port is interpolated into a remote shell command, so accept only digits.
    [[ "$WANT_PORT" =~ ^[0-9]+$ ]] && ((WANT_PORT >= 1 && WANT_PORT <= 65535)) \
        || die "PORT must be a number between 1 and 65535 (got '$WANT_PORT')."
fi
command -v ssh >/dev/null 2>&1 || die "ssh is not installed. Install OpenSSH first."

# ---------------------------------------------------------------------------
# 2-3. Ask the remote what it is serving, and make sure it is serving it.
#
# One SSH round trip does both, because every fact we need lives on the
# remote and the answer must describe the state *after* the IDE was started.
# The remote prints KEY=value lines; anything else it writes is progress
# output for the human.
# ---------------------------------------------------------------------------
step "Asking $TARGET about its KISS Sorcar deployment ..."
# 2>&1: the remote's own error messages must reach the human, and the whole
# stream is captured so the KEY=value lines can be picked out of it below.
query_remote() {
    ssh -o ConnectTimeout=15 "$TARGET" "WANT_PORT='${WANT_PORT}' bash -s" 2>&1 <<'REMOTE'
set -e
export PATH="$HOME/.local/bin:$PATH"
rinfo() { printf '\033[0;36m[%s]\033[0m %s\n' "$(hostname)" "$*"; }

# sorcar-cloud records the deployment facts here on every deploy.  Defaults
# cover a host provisioned by an older sorcar-cloud that predates the file.
STATE="$HOME/.kiss/sorcar-cloud.env"
IDE_PORT=8080
WEB_PORT=8787
WORKSPACE=""
IDE_SERVICE="kiss-code-server"
if [ -f "$STATE" ]; then
    # shellcheck disable=SC1090
    . "$STATE"
    IDE_PORT="${SORCAR_IDE_PORT:-$IDE_PORT}"
    WEB_PORT="${SORCAR_WEB_PORT:-$WEB_PORT}"
    WORKSPACE="${SORCAR_WORKSPACE:-}"
    IDE_SERVICE="${SORCAR_IDE_SERVICE:-$IDE_SERVICE}"
else
    rinfo "WARNING: $STATE is missing — assuming IDE port $IDE_PORT (deployed by an older sorcar-cloud?)."
fi
# An explicit PORT on the command line wins over the recorded one.
[ -n "$WANT_PORT" ] && IDE_PORT="$WANT_PORT"
[ -n "$WORKSPACE" ] || WORKSPACE="$HOME/kiss"

# Start the IDE if it is not already answering.  The service is a systemd
# *user* unit with Restart=always and lingering enabled, so normally it is
# already up — even after a reboot.  This is the repair path for "someone
# stopped it" and for a host whose linger was never enabled.
# /healthz is code-server's own unauthenticated liveness route, so it proves
# the editor is serving — not merely that something holds the port.  Fall back
# to a bash TCP connect on the rare host without curl.
alive() {
    if command -v curl >/dev/null 2>&1; then
        curl -sf "http://127.0.0.1:$IDE_PORT/healthz" -o /dev/null 2>/dev/null
    else
        (exec 3<>"/dev/tcp/127.0.0.1/$IDE_PORT") 2>/dev/null
    fi
}
if ! alive; then
    if command -v systemctl >/dev/null 2>&1 \
       && systemctl --user cat "$IDE_SERVICE" >/dev/null 2>&1; then
        rinfo "IDE not answering on 127.0.0.1:$IDE_PORT — starting $IDE_SERVICE ..."
        systemctl --user start "$IDE_SERVICE" 2>&1 || true
        command -v loginctl >/dev/null 2>&1 && loginctl enable-linger "$(id -un)" 2>/dev/null || true
    else
        echo "SORCAR_STATUS=no-ide"
        echo "ERROR: no code-server is listening on 127.0.0.1:$IDE_PORT and there is" >&2
        echo "       no $IDE_SERVICE user service to start.  Run sorcar-cloud from a" >&2
        echo "       machine that has the KISS Sorcar checkout to deploy it first." >&2
        exit 1
    fi
fi
up=0
for _ in $(seq 1 60); do
    if alive; then up=1; break; fi
    sleep 1
done
if [ "$up" != "1" ]; then
    echo "SORCAR_STATUS=dead"
    echo "ERROR: the IDE did not come up on 127.0.0.1:$IDE_PORT." >&2
    echo "       Check: systemctl --user status $IDE_SERVICE ; tail ~/.kiss/code-server.log" >&2
    exit 1
fi
rinfo "IDE is answering on 127.0.0.1:$IDE_PORT (workspace: $WORKSPACE)."

echo "SORCAR_STATUS=ok"
echo "SORCAR_IDE_PORT=$IDE_PORT"
echo "SORCAR_WEB_PORT=$WEB_PORT"
echo "SORCAR_WORKSPACE=$WORKSPACE"
REMOTE
}
if ! REMOTE_OUT="$(query_remote)"; then
    printf '%s\n' "$REMOTE_OUT" >&2
    die "Cannot query $TARGET.  Check the address, your SSH keys, and that sorcar-cloud has deployed there."
fi

# Show the remote's own progress lines, then read the facts out of them.
printf '%s\n' "$REMOTE_OUT" | grep -v '^SORCAR_[A-Z_]*=' || true

field() { printf '%s\n' "$REMOTE_OUT" | sed -n "s/^$1=//p" | tail -1; }
[[ "$(field SORCAR_STATUS)" == "ok" ]] \
    || die "The remote IDE is not usable (see the message above)."
PORT="$(field SORCAR_IDE_PORT)"
WEB_PORT="$(field SORCAR_WEB_PORT)"
WORKSPACE="$(field SORCAR_WORKSPACE)"
[[ "$PORT" =~ ^[0-9]+$ && "$WEB_PORT" =~ ^[0-9]+$ ]] \
    || die "The remote reported nonsense ports (IDE '$PORT', webapp '$WEB_PORT')."

# ---------------------------------------------------------------------------
# 4. Pick the local ends of the two forwards.
#
# The remote ports are fixed; only the LOCAL side may have to move.  A busy
# local port is a hard error for ssh (ExitOnForwardFailure=yes below), and a
# forward onto a port some other program owns would silently show you that
# other program.  So probe, preferring the familiar number, then +10000.
# ---------------------------------------------------------------------------
port_free() {
    # Without nc, assume free: ExitOnForwardFailure still turns a real clash
    # into a clear error instead of a silent half-open tunnel.
    command -v nc >/dev/null 2>&1 || return 0
    if nc -z 127.0.0.1 "$1" >/dev/null 2>&1; then
        return 1
    fi
    return 0
}
pick_local_port() {
    local want="$1" candidate
    for candidate in "$want" $((want + 10000)) $((want + 10001)) $((want + 10002)) $((want + 10003)); do
        ((candidate >= 1 && candidate <= 65535)) || continue
        if port_free "$candidate"; then
            printf '%s' "$candidate"
            return 0
        fi
    done
    return 1
}
LOCAL_PORT="$(pick_local_port "$PORT" || true)"
[[ -n "$LOCAL_PORT" ]] \
    || die "Local port $PORT and its fallbacks are all busy — free one (e.g. 'lsof -nP -iTCP:$PORT -sTCP:LISTEN')."
[[ "$LOCAL_PORT" == "$PORT" ]] \
    || info "Local port $PORT is busy — tunneling the remote IDE to local port $LOCAL_PORT instead."
LOCAL_WEB_PORT="$(pick_local_port "$WEB_PORT" || true)"
if [[ -z "$LOCAL_WEB_PORT" ]]; then
    warn "Local port $WEB_PORT and its fallbacks are all busy; the webapp tunnel will be skipped."
elif [[ "$LOCAL_WEB_PORT" != "$WEB_PORT" ]]; then
    info "Local port $WEB_PORT is busy — tunneling the remote webapp to $LOCAL_WEB_PORT instead."
fi
URL="http://localhost:${LOCAL_PORT}"
WEB_URL="https://localhost:${LOCAL_WEB_PORT:-$WEB_PORT}"

# ServerAliveInterval detects a dead link instead of hanging forever;
# ExitOnForwardFailure makes a local bind clash an immediate error.
TUNNEL_ARGS=(-N -n -o ExitOnForwardFailure=yes -o ServerAliveInterval=30
             -L "${LOCAL_PORT}:127.0.0.1:${PORT}")
[[ -n "$LOCAL_WEB_PORT" ]] && TUNNEL_ARGS+=(-L "${LOCAL_WEB_PORT}:127.0.0.1:${WEB_PORT}")

if [[ "$PRINT_ONLY" == "1" ]]; then
    echo ""
    echo "  Forward the ports yourself, then open ${URL} :"
    echo "    ssh ${TUNNEL_ARGS[*]} ${TARGET}"
    echo ""
    echo "  Or, with desktop VS Code + the Remote-SSH extension, skip the tunnel:"
    echo "    code --remote ssh-remote+${TARGET} ${WORKSPACE}"
    echo ""
    exit 0
fi

# ---------------------------------------------------------------------------
# 5. Open the tunnel, the browser, and hold.
#
# The tunnel is backgrounded by THIS shell (not by ssh's own -f) so "$!"
# gives its pid for certain: that is what lets the Ctrl+C trap below tear it
# down, and it makes the tunnel our child, so closing the terminal (SIGHUP)
# takes it with us instead of leaking a forward that blocks the next run.
# ---------------------------------------------------------------------------
step "Opening SSH tunnels to ${TARGET} (IDE ${LOCAL_PORT}->${PORT}, webapp ${LOCAL_WEB_PORT:-none}) ..."
ssh "${TUNNEL_ARGS[@]}" "$TARGET" &
TUNNEL_PID=$!
# ExitOnForwardFailure=yes makes ssh EXIT when a local bind clashes, so
# "still running after the grace period" is what proves the forwards were
# granted.  Deliberately NOT probing the local port: a busy port answers a
# probe no matter who owns it, so a foreign listener would look like success.
for _ in $(seq 1 10); do
    kill -0 "$TUNNEL_PID" 2>/dev/null || break
    sleep 0.5
done
kill -0 "$TUNNEL_PID" 2>/dev/null \
    || die "Could not open the SSH tunnels (is local port $LOCAL_PORT already in use?)."
trap 'echo ""; info "Closing the SSH tunnels..."; kill "$TUNNEL_PID" 2>/dev/null || true; exit 0' INT TERM
info "Tunnels are up (ssh pid $TUNNEL_PID)."

# The browser is what ACTIVATES the KISS Sorcar extension: code-server loads
# it only when a real browser runs the workbench JavaScript, and the
# extension is what starts the kiss-web webapp.  So the browser comes first,
# and the webapp check after it.
if [[ "$OPEN_BROWSER" == "1" ]]; then
    info "KISS Sorcar (remote code-server) is ready at $URL — opening your browser..."
    case "$(uname -s)" in
        Darwin) open "$URL" >/dev/null 2>&1 || true ;;
        Linux)  command -v xdg-open >/dev/null 2>&1 && (xdg-open "$URL" >/dev/null 2>&1 &) || true ;;
    esac
else
    info "KISS Sorcar (remote code-server) is ready at $URL (browser not opened)."
fi

if [[ -n "$LOCAL_WEB_PORT" && "$OPEN_BROWSER" == "1" ]] && command -v curl >/dev/null 2>&1; then
    step "Waiting for the remote webapp to come up at ${WEB_URL} ..."
    web_up=0
    for _ in $(seq 1 90); do
        # kiss-web serves HTTPS with a self-signed cert (hence -k) and has no
        # /healthz route, so probe the document root.
        if curl -skf "$WEB_URL/" -o /dev/null 2>/dev/null; then
            web_up=1; break
        fi
        sleep 2
    done
    if [[ "$web_up" == "1" ]]; then
        info "Remote webapp (kiss-web) is live at ${WEB_URL}"
    else
        warn "The remote webapp did not answer within 3 minutes."
        warn "  It starts when the KISS Sorcar extension activates — keep the"
        warn "  IDE tab open, then check on ${TARGET}:"
        warn "    systemctl --user status kiss-web ; tail ~/.kiss/kiss-web-stderr.log"
    fi
fi

echo ""
echo "  ┌──────────────────────────────────────────────────┐"
echo "  │  KISS Sorcar (remote code-server): ${URL}"
if [[ -n "$LOCAL_WEB_PORT" ]]; then
echo "  │  Remote webapp (kiss-web):         ${WEB_URL}"
fi
echo "  │  Remote host:  ${TARGET}"
echo "  │  Remote path:  ${WORKSPACE}"
echo "  │  Stop tunnel:  Ctrl+C (remote IDE keeps running)"
echo "  │  Remote log:   ~/.kiss/code-server.log on ${TARGET}"
echo "  └──────────────────────────────────────────────────┘"
echo ""
info "Tunnels held open.  Press Ctrl+C to close them."
# Poll instead of ``wait``: wait would swallow the signal until ssh returns,
# leaving the forwarded port bound after Ctrl+C.
while kill -0 "$TUNNEL_PID" 2>/dev/null; do
    sleep 5
done
warn "The SSH tunnel process exited."
