#!/bin/bash
# Author: Koushik Sen (ksen@berkeley.edu)
# Contributors:
# Koushik Sen (ksen@berkeley.edu)
# add your name here
#
# Push the *local* KISS Sorcar checkout (the folder that contains this
# script) to a remote Linux machine over SSH, run its ``install.sh`` there,
# start code-server plus the kiss-web webapp, and open your local browser
# at the tunneled port.
#
# Unlike ``sorcar-linux`` — which curls a fresh checkout of ``kiss_ai`` from
# GitHub — ``sorcar-cloud`` ships *this exact working directory* (your
# uncommitted edits included) to the remote host.  Use it when you want the
# remote code-server to run the code you have right now on your laptop, not
# the last commit on ``main``.
#
# Usage:  ./sorcar-cloud [--keep-remote] user@ip-address [PORT]
#         ./sorcar-cloud --connect     user@ip-address [PORT]
#
# ``--connect`` deploys NOTHING: it just opens the IDE that is already
# running on the host.  It is a shortcut for the companion script
# ``./sorcar-connect``, which is a single self-contained file that needs only
# bash and ssh — copy it to any machine that can SSH into the host
# (``scp user@host:<project>/sorcar-connect .``) and that machine can open the
# remote IDE too.  This works because step 7 leaves the IDE running as a
# systemd *user* service with lingering enabled (so it survives logouts and
# reboots) and records its ports in ~/.kiss/sorcar-cloud.env on the host for
# any client to read.
#
# Flow (every run is a full, from-scratch redeploy):
#   1. SSH connectivity check.
#   2. DELETE  ~/<basename>  on the remote host, then copy the local folder
#      there verbatim — node_modules, build output and every dotfile travel
#      exactly as they are on the laptop.  Two things are NOT cloned,
#      because they describe the laptop rather than the project:
#        .venv  a virtualenv is machine-bound (the laptop's points at a
#               macOS/arm64 interpreter and holds Mach-O .so files), and
#               nothing downstream repairs a foreign one — so it is left
#               out of the copy and any unusable one already on the remote
#               is deleted before install.sh runs (step 6).  The remote
#               builds its own from uv.lock.
#        .git   a git *worktree* stores an absolute laptop path in its
#               ``.git`` file, meaningless on the remote, so the remote
#               copy gets a fresh single-commit repo instead.
#   3. Copy  ~/.kiss/  (models, credentials, task templates, config) to
#      the remote, minus host-local state that must not be cloned
#      (databases, sockets, logs, browser profiles, TLS certs, the
#      kiss-web fingerprint and the laptop's tunnel URL).  ``work_dir`` in
#      config.json is rewritten to the remote workspace path.  The laptop's
#      ~/.ssh/ (private keys, config, known_hosts) is copied too so the
#      remote can push to git and hop to other hosts — but authorized_keys
#      is NEVER copied, so it can't overwrite the keys that let you ssh in.
#   4. Copy the local shell rc file that holds your API keys (the first of
#      ~/.zshrc  ~/.bashrc  ~/.envrc  ~/.profile  ~/.bash_profile
#      ~/.zprofile that contains an "API_KEY" line) to $HOME on the remote
#      host, and distill it into two machine-readable env files that
#      install.sh, code-server and the kiss-web systemd unit all consume.
#   5. Install code-server (standalone, no sudo) if it is missing, plus a
#      ``code`` shim so the copied ``install.sh`` drops the built VSIX into
#      code-server instead of a desktop VS Code a headless server lacks.
#   6. Delete any leftover ``.venv`` in the remote workspace that cannot
#      run there (its bin/python must execute and bin/kiss-web must exist),
#      then run the FULL ``install.sh`` with KISS_CODE_CLI=code-server,
#      KISS_SKIP_LAUNCH=1 (skip the desktop launch — we start code-server
#      ourselves) and KISS_SKIP_UPDATE=1 (never pull origin/main over the
#      working directory we just shipped).
#   7. Install code-server as a systemd *user* service bound to
#      127.0.0.1:$PORT with the copied folder as its workspace, enable
#      lingering for the remote user, and record the deployment (ports,
#      workspace, service name) in ~/.kiss/sorcar-cloud.env.  A user service
#      with Restart=always plus lingering means the IDE comes back by itself
#      after a crash, a logout or a reboot, and the recorded ports let any
#      machine discover it — which is what makes step 8 runnable from
#      anywhere, at any time, without redeploying.
#   8. Hand over to ``./sorcar-connect``, which forwards the IDE and webapp
#      ports over SSH, opens your browser at the IDE — which activates the
#      extension and therefore starts kiss-web — and holds the tunnel until
#      Ctrl+C.  Nothing about that step is specific to this laptop, so it is
#      a separate script you can run from any machine with SSH access.
#
# ``--keep-remote`` skips step 2's delete and rsyncs in place instead
# (faster, but the remote keeps files you have since deleted locally).
set -euo pipefail

# The kiss-web webapp always binds this port on the remote host (see
# kiss.server.web_server.main → RemoteAccessServer, host="0.0.0.0").  Reaching
# it through the SSH tunnel below is what keeps that open bind private.
WEB_PORT=8787

# The IDE runs as this systemd *user* unit on the remote (see step 7h).  The
# name is deliberately not "code-server" so we never fight a unit the host's
# package manager owns.
IDE_SERVICE=kiss-code-server

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# Everything about connecting to an already-deployed host lives in this one
# self-contained companion script, so any machine with ssh keys can do it.
CONNECT_SCRIPT="$SCRIPT_DIR/sorcar-connect"

# ---------------------------------------------------------------------------
# Logging helpers (mirrors sorcar-linux / sorcar-docker)
# ---------------------------------------------------------------------------
info() { printf '\033[0;32m[INFO]\033[0m  %s\n' "$*"; }
step() { printf '\033[0;34m[STEP]\033[0m  %s\n' "$*"; }
warn() { printf '\033[1;33m[WARN]\033[0m  %s\n' "$*"; }
die()  { printf '\033[0;31m[ERR]\033[0m  %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# 1. Parse arguments
# ---------------------------------------------------------------------------
WIPE_REMOTE=1
CONNECT_ONLY=0
ARGS=()
for arg in "$@"; do
    case "$arg" in
        --keep-remote) WIPE_REMOTE=0 ;;
        --connect|--attach) CONNECT_ONLY=1 ;;
        # Accepted for backwards compatibility: every run is already a full
        # reinstall, so --force is now a no-op.
        --force|-f) ;;
        -h|--help)
            # Print the header comment block: everything from line 2 up to
            # (but not including) the first non-comment line.  Deriving the
            # range keeps --help correct when the header grows.
            awk 'NR>1 && /^[^#]/{exit} NR>1{sub(/^# ?/, ""); print}' "$0"
            exit 0 ;;
        *) ARGS+=("$arg") ;;
    esac
done
TARGET="${ARGS[0]:-}"
PORT="${ARGS[1]:-8080}"

# --connect: there is nothing to deploy — open the IDE that is already
# running on the host.  Hand the whole job to sorcar-connect rather than
# duplicating it here, so the code that other machines run is the same code
# this one runs (and therefore cannot rot).
if [[ "$CONNECT_ONLY" == "1" ]]; then
    [[ -x "$CONNECT_SCRIPT" ]] \
        || die "$CONNECT_SCRIPT is missing or not executable — it ships next to this script."
    if [[ -n "${ARGS[1]:-}" ]]; then
        exec "$CONNECT_SCRIPT" "$TARGET" "${ARGS[1]}"
    fi
    exec "$CONNECT_SCRIPT" "$TARGET"
fi

[[ -n "$TARGET" ]] || die "Usage: $0 [--keep-remote|--connect] user@ip-address [PORT]"
[[ "$TARGET" == *"@"* ]] || warn "TARGET '$TARGET' has no 'user@' part; using the SSH default user."

# PORT is interpolated into remote shell command strings (and into a pkill
# pattern), so reject anything that is not a plain TCP port number.
[[ "$PORT" =~ ^[0-9]+$ ]] && ((PORT >= 1 && PORT <= 65535)) \
    || die "PORT must be a number between 1 and 65535 (got '$PORT')."

# ---------------------------------------------------------------------------
# 2. Pre-flight checks (local)
# ---------------------------------------------------------------------------
command -v ssh   &>/dev/null || die "ssh is not installed. Install OpenSSH first."
command -v scp   &>/dev/null || die "scp is not installed. Install OpenSSH first."
command -v rsync &>/dev/null || die "rsync is not installed. Install rsync first."
command -v curl  &>/dev/null || die "curl is not installed. Install curl first."

[[ -f "$SCRIPT_DIR/install.sh" ]] || die "install.sh not found in $SCRIPT_DIR — is this really the kiss checkout?"
# The deploy ends by handing over to it (step 8), so fail now rather than
# after a 10-minute install.
[[ -x "$CONNECT_SCRIPT" ]] || die "$CONNECT_SCRIPT not found or not executable — it ships next to this script."

# Determine the *logical* project name for the remote directory.
# Priority:
#   1. $SORCAR_REMOTE_DIR       — explicit override.
#   2. Git worktree main repo   — if SCRIPT_DIR is a worktree
#                                 (.git is a file, not a dir), the main
#                                 repo's basename is what the user knows
#                                 the project as (e.g. "kiss"), not the
#                                 worktree hash directory (kiss_wt-abcd…).
#   3. basename $SCRIPT_DIR     — plain fallback.
if [[ -n "${SORCAR_REMOTE_DIR:-}" ]]; then
    SCRIPT_BASE="$SORCAR_REMOTE_DIR"
elif [[ -f "$SCRIPT_DIR/.git" ]]; then
    # Worktree: .git contains "gitdir: <main>/.git/worktrees/<name>"
    GITDIR_LINE="$(sed -n 's/^gitdir: //p' "$SCRIPT_DIR/.git" | head -1)"
    MAIN_REPO=""
    if [[ -n "$GITDIR_LINE" ]]; then
        # Handle both absolute and script-dir-relative gitdir paths.
        case "$GITDIR_LINE" in
            /*) ABS_GITDIR="$GITDIR_LINE" ;;
            *)  ABS_GITDIR="$SCRIPT_DIR/$GITDIR_LINE" ;;
        esac
        # <main>/.git/worktrees/<name> — climb three parents.
        MAIN_REPO="$(cd "$ABS_GITDIR/../../.." 2>/dev/null && pwd || true)"
    fi
    if [[ -n "$MAIN_REPO" ]]; then
        SCRIPT_BASE="$(basename "$MAIN_REPO")"
        info "Worktree detected — will use logical project name '$SCRIPT_BASE' on the remote."
    else
        SCRIPT_BASE="$(basename "$SCRIPT_DIR")"
    fi
else
    SCRIPT_BASE="$(basename "$SCRIPT_DIR")"
fi

# Never let a typo turn the remote wipe into "rm -rf $HOME".
case "$SCRIPT_BASE" in
    ""|"."|".."|"/"|*/*) die "Refusing to use '$SCRIPT_BASE' as the remote directory name." ;;
esac

step "Checking SSH connectivity to $TARGET..."
ssh -o ConnectTimeout=15 -o BatchMode=no "$TARGET" 'echo ok' >/dev/null \
    || die "Cannot SSH into $TARGET. Check the address and your SSH keys."
info "SSH connection OK"

REMOTE_HOME="$(ssh "$TARGET" 'printf %s "$HOME"')"
[[ -n "$REMOTE_HOME" ]] || die "Could not determine \$HOME on $TARGET."
REMOTE_DIR="$REMOTE_HOME/$SCRIPT_BASE"
info "Remote workspace will be $REMOTE_DIR"

# ---------------------------------------------------------------------------
# 3. Find the shell rc file that carries API keys
# ---------------------------------------------------------------------------
RC_FILE=""
for candidate in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.envrc" "$HOME/.bash_profile" "$HOME/.zprofile" "$HOME/.profile"; do
    if [[ -f "$candidate" ]] && grep -q "API_KEY" "$candidate" 2>/dev/null; then
        RC_FILE="$candidate"; break
    fi
done
if [[ -z "$RC_FILE" ]]; then
    warn "No ~/.*rc / profile file with an *API_KEY* line was found — the remote install will proceed without API keys."
else
    info "Found API-key rc file: $RC_FILE"
fi

# ---------------------------------------------------------------------------
# 4. Delete the remote folder, then copy the local one over.
#
# The delete makes every run a clean redeploy: no file the laptop no longer
# has can linger on the remote, and no half-built artifact from an older
# deploy can confuse install.sh.  A previous run's ``.venv`` is torn down
# with it, which is exactly what "run the full install.sh" implies.
#
# The copy is verbatim except for ONE filter: ``.venv``.  A virtualenv is
# not source — it is a machine-bound build artifact.  The laptop's is a
# 1.2 GB macOS/arm64 tree whose ``pyvenv.cfg`` says
# ``home = ~/.local/share/uv/python/cpython-3.14-macos-aarch64-none/bin``,
# whose ``bin/python`` is a symlink into a path that does not exist on
# Linux, and whose site-packages hold Mach-O ``.so`` files the remote
# CPython cannot load.  Copying it would be worse than useless: nothing in
# ``install.sh`` rebuilds a Python environment, and the extension that does
# (DependencyInstaller.ts) only runs ``uv sync`` ``if (!venvExists)`` — a
# mere *directory* named ``.venv`` sends it down the "Fast path: uv and
# .venv present" branch, so the broken macOS venv would be adopted as-is
# and ``.venv/bin/kiss-web`` (the systemd unit's ExecStart) would never
# exist.  Step 7f deletes any ``.venv`` that cannot run on the remote as a
# second line of defence.  Everything else still travels as-is:
# node_modules, build output and every dotfile.
#
# Two transports, chosen by ``copy_tree``:
#   tar | ssh tar   for the from-scratch copy.  One stream, one round trip,
#                   no per-file protocol chatter — the fastest way to move a
#                   few hundred MB into an empty directory.  It matters
#                   because macOS ships *openrsync*, whose per-file
#                   handshake crawls on a tree this size.
#   rsync -aHz      for --keep-remote, where the destination already has
#                   most of the content and only deltas need to move.
# Both preserve permissions, symlinks and mtimes.  Neither prunes: after a
# wipe there is nothing to prune, and --keep-remote is meant to be additive.
# ---------------------------------------------------------------------------

# Stream SRC/ (contents, not the directory itself) into TARGET:DST/.
copy_tree() {
    local src="$1" dst="$2"
    if [[ "$WIPE_REMOTE" == "1" ]]; then
        # -C src . : archive the contents so they land directly in dst.
        # -p keeps permissions, -z compresses on the laptop's CPU.
        # --no-xattrs: macOS xattrs (com.apple.provenance etc.) mean nothing
        # on Linux and make GNU tar print a warning per file.
        # COPYFILE_DISABLE=1: stop macOS bsdtar from adding AppleDouble
        # "._foo" companion entries, which would litter the remote tree
        # (and end up inside the built VSIX).
        # --exclude='.venv': see the block comment above — a virtualenv is
        # host-bound, and the pattern is unanchored so nested project venvs
        # are skipped too.
        # --exclude='.kiss-worktrees': agent task worktrees live in
        # <repo>/.kiss-worktrees/kiss_wt-*.  They are laptop scratch space —
        # every one is another full checkout (node_modules included) whose
        # ``.git`` is a one-line file pointing at an absolute laptop path, so
        # shipping them multiplies the transfer and drags dead git pointers
        # into the snapshot commit step 7e makes.  The remote creates its own.
        # ``|| true`` plus an explicit PIPESTATUS check instead of letting
        # ``set -e``/``pipefail`` abort: tar exits 1 for mere WARNINGS, and
        # the most common one is unavoidable here — "file changed as we read
        # it", because a live checkout keeps writing (a log under tmp/, an
        # editor autosave) while we archive it.  Aborting on that threw away
        # a completed 200 MB transfer and, worse, printed nothing at all,
        # since set -e exits without a message.  So: 1 = warn and go on,
        # >=2 = a real tar error, and any nonzero from the receiving ssh is
        # fatal (that is the half of the pipe that can lose data).
        COPYFILE_DISABLE=1 tar --no-xattrs --exclude='.venv' \
            --exclude='.kiss-worktrees' -C "$src" -czpf - . \
            | ssh "$TARGET" "mkdir -p -- '$dst' && tar -C '$dst' -xzpf -" || true
        local tar_rc="${PIPESTATUS[0]}" ssh_rc="${PIPESTATUS[1]}"
        ((ssh_rc == 0)) || die "The remote refused the copy (ssh/tar exit $ssh_rc)."
        ((tar_rc <= 1)) || die "Local tar failed with exit $tar_rc — the copy is incomplete."
        ((tar_rc == 0)) || warn "tar reported warnings (exit 1) — usually a file that changed while being read."
    else
        # --exclude='.venv': never overwrite the remote's own working
        # virtualenv with the laptop's macOS one (and never waste the
        # transfer); step 7f removes it if it turns out to be unusable.
        # --exclude='.git': in --keep-remote mode the remote already has the
        # self-contained snapshot repo created by an earlier run, while a
        # local worktree's ``.git`` is a one-line *file*.  rsync cannot
        # replace a non-empty directory with a file and aborts with
        # "unlinkat: Directory not empty" (rc=23), so leave git plumbing
        # alone and let step 7e refresh the snapshot instead.
        # --exclude='.kiss-worktrees': laptop-local agent worktrees, same
        # reasoning as the tar path above.
        rsync -aHz --numeric-ids --stats \
            --exclude='.git' --exclude='.venv' --exclude='.kiss-worktrees' \
            -e ssh "$src/" "$TARGET:$dst/"
    fi
}
if [[ "$WIPE_REMOTE" == "1" ]]; then
    step "Deleting $TARGET:$REMOTE_DIR (if it exists) ..."
    # Any code-server / kiss-web still running out of the doomed directory
    # would keep rewriting it (and hold deleted inodes open) while we copy.
    ssh "$TARGET" "REMOTE_DIR='$REMOTE_DIR' IDE_SERVICE='$IDE_SERVICE' bash -s" <<'WIPE'
set -e
export PATH="$HOME/.local/bin:$PATH"
# Stop the IDE through systemd FIRST: its unit is Restart=always, so a bare
# pkill would only make the user manager start it again — on the directory we
# are about to delete.  The pkill afterwards catches an IDE started by an
# older sorcar-cloud (setsid, no unit) or by hand.
if command -v systemctl >/dev/null 2>&1; then
    systemctl --user stop "$IDE_SERVICE" 2>/dev/null || true
    systemctl --user stop kiss-web 2>/dev/null || true
fi
pkill -f 'code-server' 2>/dev/null || true
pkill -f '/kiss-web$' 2>/dev/null || true
sleep 1
case "$REMOTE_DIR" in
    "$HOME"/?*) rm -rf -- "$REMOTE_DIR" ;;
    *) echo "ERROR: refusing to delete '$REMOTE_DIR' — not a child of \$HOME" >&2; exit 1 ;;
esac
echo "deleted: $REMOTE_DIR"
WIPE
    info "Remote folder removed."
else
    warn "--keep-remote given: rsyncing in place instead of redeploying from scratch."
fi

step "Copying $SCRIPT_DIR/ -> $TARGET:$REMOTE_DIR/ (verbatim except .venv) ..."
copy_tree "$SCRIPT_DIR" "$REMOTE_DIR"
info "Folder copy complete: $(ssh "$TARGET" "du -sh -- '$REMOTE_DIR' 2>/dev/null | cut -f1")"

# ---------------------------------------------------------------------------
# 5a. Copy ~/.kiss/ so the remote inherits models, credentials and settings.
#
# "Verbatim" is the wrong contract for ~/.kiss: several entries are *host*
# state, not user state, and cloning them actively breaks the remote.
#   sorcar.db / -wal / -shm  the task database — multi-GB, and a WAL copied
#                            out of step with its db is corrupt.  The
#                            remote creates its own.
#   sorcar.sock              a unix socket; copying it is meaningless.
#   *.log, install.log       laptop logs (tens of MB), pure noise.
#   browser_profile*         Chromium profiles, gigabytes, machine-bound.
#   tls/                     the webapp regenerates a self-signed cert for
#                            its own host on first start.
#   .kiss-web.fingerprint    the extension SKIPS restarting kiss-web when
#                            this matches, which would leave the remote
#                            webapp dead.  Never copy it (and delete any
#                            stale one below).
#   remote-url.json          the laptop's cloudflared URL; the remote
#                            publishes its own.
#   cloudflared.pid          a pid from the laptop's process table.
#   .config.lock             a lock guarding config.json writes.
#   api_keys*.env            REMOTE-only files that step 6 writes.  They do
#                            not exist on the laptop, so without this the
#                            --delete pass would erase the remote's
#                            credentials — and on a laptop with no
#                            *API_KEY* rc file step 6 is skipped, so nothing
#                            would put them back.
# Everything else — MY_MODELS.json, MY_INJECTION.md, MY_TASK_TEMPLATES.md,
# MODEL_INFO.json, third_party_agents/ (gmail/slack tokens), models/
# (Vosk speech models), cli_history/, config.json — does travel.
# ---------------------------------------------------------------------------
if [[ -d "$HOME/.kiss" ]]; then
    step "Copying ~/.kiss/ -> $TARGET:~/.kiss/ ..."
    ssh "$TARGET" 'mkdir -p "$HOME/.kiss" && chmod 700 "$HOME/.kiss"'
    # --delete mirrors the laptop for the entries we DO copy, so something you
    # removed locally (a retired MY_MODELS.json override, say) cannot linger on
    # the remote and shadow the new state.  rsync also protects every
    # --exclude'd path from the delete pass, so the remote keeps its own
    # database, logs, socket, TLS cert and browser profiles.
    rsync -aHz --numeric-ids --delete -e ssh \
        --exclude='sorcar.db' \
        --exclude='sorcar.db-wal' \
        --exclude='sorcar.db-shm' \
        --exclude='sorcar.sock' \
        --exclude='*.log' \
        --exclude='browser_profile*' \
        --exclude='tls/' \
        --exclude='.kiss-web.fingerprint' \
        --exclude='remote-url.json' \
        --exclude='cloudflared.pid' \
        --exclude='.config.lock' \
        --exclude='api_keys.env' \
        --exclude='api_keys.systemd.env' \
        --exclude='sorcar-cloud.env' \
        --exclude='.DS_Store' \
        "$HOME/.kiss/" "$TARGET:.kiss/"

    # config.json carries an absolute ``work_dir`` from the laptop
    # (/Users/…/kiss).  The kiss-web webapp reads it directly
    # (web_server.py: work_dir = load_config().get("work_dir")), so a stale
    # macOS path would leave every browser-launched task rooted at a
    # directory that does not exist on the remote.
    ssh "$TARGET" "WORKSPACE='$REMOTE_DIR' bash -s" <<'FIXCFG'
set -e
CFG="$HOME/.kiss/config.json"
[ -f "$CFG" ] || exit 0
if command -v python3 >/dev/null 2>&1; then
    WORKSPACE="$WORKSPACE" python3 - "$CFG" <<'PY'
import json, os, sys
path = sys.argv[1]
try:
    with open(path) as f:
        cfg = json.load(f)
except Exception:
    cfg = {}
if not isinstance(cfg, dict):
    cfg = {}
cfg["work_dir"] = os.environ["WORKSPACE"]
with open(path, "w") as f:
    json.dump(cfg, f, indent=2)
PY
fi
chmod 600 "$CFG"
FIXCFG
    # Force the extension to (re)start kiss-web on this host: it skips the
    # restart whenever the saved fingerprint still matches.
    ssh "$TARGET" 'rm -f "$HOME/.kiss/.kiss-web.fingerprint"'
    info "~/.kiss copied (work_dir -> $REMOTE_DIR, kiss-web fingerprint cleared)."
else
    warn "No local ~/.kiss directory — skipping."
fi

# ---------------------------------------------------------------------------
# 5b. Copy ~/.ssh/ so the remote inherits your SSH identity — private keys,
# client config and known_hosts — which lets the remote push to git, clone
# private repos and hop to other hosts as "you".  Two hard safety rules:
#
#   * authorized_keys / authorized_keys2 are NEVER copied.  Those files list
#     the keys allowed to log INTO a host; on the laptop they authorize
#     access to the LAPTOP.  Overwriting the remote's copy would replace the
#     very keys that let this script (and you) ssh into the remote — a great
#     way to lock yourself out.  So they are excluded, and nothing is
#     appended to the remote's authorized_keys.
#
#   * No --delete: the copy is purely additive.  A key or host entry that
#     exists only on the remote is preserved, never pruned.
#
# ssh refuses to use a key directory or a private key with group/other
# permissions, so the tree is re-permissioned on the remote AFTER the copy:
# 700 on ~/.ssh itself, 600 on every file, and 644 on the world-safe ones
# (*.pub, known_hosts*).  Control-master sockets (*.sock) and macOS's
# .DS_Store are skipped — they are host-local junk, not identity.
# ---------------------------------------------------------------------------
if [[ -d "$HOME/.ssh" ]]; then
    step "Copying ~/.ssh/ -> $TARGET:~/.ssh/ (excluding authorized_keys) ..."
    ssh "$TARGET" 'mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"'
    rsync -aHz --numeric-ids -e ssh \
        --exclude='authorized_keys' \
        --exclude='authorized_keys2' \
        --exclude='environment' \
        --exclude='*.sock' \
        --exclude='.DS_Store' \
        "$HOME/.ssh/" "$TARGET:.ssh/"
    # -a preserves the laptop's modes, but a differing remote umask (or a
    # pre-existing loose file) would make ssh reject the keys, so nail the
    # permissions down explicitly.
    ssh "$TARGET" 'bash -s' <<'FIXSSH'
set -e
chmod 700 "$HOME/.ssh" 2>/dev/null || true
find "$HOME/.ssh" -type f -exec chmod 600 {} + 2>/dev/null || true
find "$HOME/.ssh" -type f \( -name '*.pub' -o -name 'known_hosts*' \) \
    -exec chmod 644 {} + 2>/dev/null || true
FIXSSH
    info "~/.ssh copied (authorized_keys left untouched; permissions fixed on remote)."
else
    warn "No local ~/.ssh directory — skipping."
fi

# ---------------------------------------------------------------------------
# 6. Ship API keys to the remote host.
#
# Three artifacts, because three different consumers need three shapes:
#   (a) ~/<rc-basename>            the rc file verbatim, plus a sourcing
#                                  line spliced into the remote ~/.bashrc,
#                                  so plain `ssh user@host` sessions behave
#                                  like the laptop.
#   (b) ~/.kiss/api_keys.env       only the credential-looking
#                                  `export FOO=bar` lines.  Sourcing a
#                                  whole zsh-flavoured .zshrc under bash is
#                                  unreliable (zsh-only builtins, ${var:h}
#                                  splits); if it aborts early the exports
#                                  never run and the extension ends up
#                                  prompting for API keys.  A plain
#                                  `export KEY=VAL` file is bulletproof, so
#                                  install.sh and code-server use this one.
#   (c) ~/.kiss/api_keys.systemd.env  the same keys with no `export` and no
#                                  shell-environment entries, for the
#                                  kiss-web systemd user unit (systemd does
#                                  not expand $VAR in an EnvironmentFile,
#                                  so a leaked PATH=...:$PATH would clobber
#                                  the service PATH).  Written here, on the
#                                  laptop side of the fence, rather than
#                                  re-derived on the remote.
# ---------------------------------------------------------------------------
REMOTE_RC_NAME=""
if [[ -n "$RC_FILE" ]]; then
    REMOTE_RC_NAME="$(basename "$RC_FILE")"
    step "Copying $RC_FILE -> $TARGET:~/$REMOTE_RC_NAME"
    scp -p "$RC_FILE" "$TARGET:$REMOTE_RC_NAME" >/dev/null

    # NAME must be an upper-case identifier so we skip lowercase locals and
    # PS1-ish variables.  Both `export NAME=value` and a bare `NAME=value`
    # are accepted; the latter is wrapped with `export`.
    ENV_TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/sorcar-cloud.XXXXXX")"
    trap 'rm -rf "$ENV_TMP_DIR"' EXIT
    API_KEYS_ENV="$ENV_TMP_DIR/api_keys.env"
    API_KEYS_SYSTEMD="$ENV_TMP_DIR/api_keys.systemd.env"
    {
        echo "# Auto-generated by sorcar-cloud from $RC_FILE"
        echo "# Sourced by install.sh and by the code-server launcher on the remote."
        # `|| true` — an rc file with zero matching lines must not fail the pipe.
        grep -E '^[[:space:]]*(export[[:space:]]+)?[A-Z][A-Z0-9_]*=' "$RC_FILE" 2>/dev/null \
            | sed -E 's/^[[:space:]]*//; s/^([A-Z][A-Z0-9_]*=)/export \1/' \
            || true
    } > "$API_KEYS_ENV"
    grep -E '^export ' "$API_KEYS_ENV" \
        | sed -E 's/^export +//' \
        | grep -vE '^(PATH|MANPATH|LD_LIBRARY_PATH|PS1|PROMPT|LANG|LC_[A-Z]+)=' \
        > "$API_KEYS_SYSTEMD" || true
    info "Extracted $(grep -cE '^export ' "$API_KEYS_ENV" || true) export lines from $RC_FILE."

    ssh "$TARGET" 'mkdir -p "$HOME/.kiss" && chmod 700 "$HOME/.kiss"'
    scp -p "$API_KEYS_ENV" "$TARGET:.kiss/api_keys.env" >/dev/null
    scp -p "$API_KEYS_SYSTEMD" "$TARGET:.kiss/api_keys.systemd.env" >/dev/null

    ssh "$TARGET" "REMOTE_RC_NAME='$REMOTE_RC_NAME' bash -s" <<'ENSURE_SOURCED'
set -e
chmod 600 "$HOME/.kiss/api_keys.env" "$HOME/.kiss/api_keys.systemd.env"
MARKER="# sorcar-cloud: source API-keys rc"
END_MARKER="# sorcar-cloud: end"
touch "$HOME/.bashrc"
# Source ONLY api_keys.env — never the copied rc itself.  The rc is usually a
# ~/.zshrc full of zsh-only syntax (${var:h}, setopt, zstyle); sourcing it from
# bash aborts partway and the exports after the failure never run, which is the
# exact failure mode api_keys.env exists to avoid.  The verbatim rc still lands
# in $HOME for reference.
#
# The block is delimited so a re-run REPLACES it instead of skipping when a
# marker is already present — otherwise a stale block written by an older
# version of this script (e.g. one that sourced ~/.zshrc from bash) would
# survive every future deploy.
if grep -qF "$MARKER" "$HOME/.bashrc" 2>/dev/null; then
    awk -v m="$MARKER" -v e="$END_MARKER" '
        $0 == m {skip = 1; next}
        skip && $0 == e {skip = 0; next}
        # Blocks written before END_MARKER existed have no terminator: stop
        # skipping at the first blank line that follows their last entry.
        skip && /^[[:space:]]*$/ {skip = 0; next}
        !skip {print}
    ' "$HOME/.bashrc" > "$HOME/.bashrc.sorcar-tmp" \
        && mv "$HOME/.bashrc.sorcar-tmp" "$HOME/.bashrc"
fi
printf '\n%s\n[ -f "$HOME/.kiss/api_keys.env" ] && . "$HOME/.kiss/api_keys.env"\nexport PATH="$HOME/.local/bin:$PATH"\n%s\n' \
    "$MARKER" "$END_MARKER" >> "$HOME/.bashrc"
# The kiss-web webapp runs as a systemd *user* service (Restart=always),
# and systemd services inherit nothing from a login shell.  A drop-in
# survives the extension rewriting kiss-web.service itself, so install it
# even before the unit exists — systemd picks it up when the unit appears.
mkdir -p "$HOME/.config/systemd/user/kiss-web.service.d"
printf '[Service]\nEnvironmentFile=%%h/.kiss/api_keys.systemd.env\n' \
    > "$HOME/.config/systemd/user/kiss-web.service.d/override.conf"
if command -v systemctl >/dev/null 2>&1; then
    systemctl --user daemon-reload 2>/dev/null || true
fi
ENSURE_SOURCED
    info "API keys installed on remote (~/$REMOTE_RC_NAME, ~/.kiss/api_keys.env, systemd drop-in)."
fi

# ---------------------------------------------------------------------------
# 7. Remote bootstrap: code-server + code shim + full install.sh + launch.
# ---------------------------------------------------------------------------
step "Bootstrapping code-server and running the full install.sh on $TARGET..."

ssh "$TARGET" \
    "PORT='$PORT' \
     WEB_PORT='$WEB_PORT' \
     IDE_SERVICE='$IDE_SERVICE' \
     REMOTE_BASE='$SCRIPT_BASE' \
     bash -s" <<'REMOTE'
set -e
PORT="${PORT:-8080}"
WEB_PORT="${WEB_PORT:-8787}"
IDE_SERVICE="${IDE_SERVICE:-kiss-code-server}"
WORKSPACE="$HOME/$REMOTE_BASE"
export PATH="$HOME/.local/bin:$PATH"
LOG_DIR="$HOME/.kiss"
mkdir -p "$LOG_DIR" "$HOME/.local/bin"

rinfo() { printf '\033[0;36m[%s]\033[0m %s\n' "$(hostname)" "$*"; }

# Load the extracted API keys into THIS shell so install.sh's children —
# and, crucially, the code-server we launch at the end — inherit
# ANTHROPIC_API_KEY, OPENAI_API_KEY, etc.
if [ -f "$HOME/.kiss/api_keys.env" ]; then
    set +e
    # shellcheck disable=SC1090
    . "$HOME/.kiss/api_keys.env"
    set -e
fi

[ -d "$WORKSPACE" ] || { echo "ERROR: $WORKSPACE missing on remote (copy failed?)" >&2; exit 1; }
[ -f "$WORKSPACE/install.sh" ] || { echo "ERROR: $WORKSPACE/install.sh missing on remote" >&2; exit 1; }
chmod +x "$WORKSPACE/install.sh"

# --- 7a. Build prerequisites (best-effort) -----------------------------
# The KISS runtime's `uv sync` may need to compile native wheels (e.g.
# pyiceberg has no wheel for the newest CPython), which requires a C
# toolchain.  Fresh cloud VMs ship without one.  Install it when we have
# passwordless sudo + apt; otherwise just warn and continue.
if ! command -v cc >/dev/null 2>&1; then
    if sudo -n true 2>/dev/null && command -v apt-get >/dev/null 2>&1; then
        rinfo "Installing build-essential (C toolchain for native Python wheels)..."
        sudo apt-get update -qq -y >/dev/null 2>&1 || true
        sudo apt-get install -qq -y build-essential >/dev/null 2>&1 \
            || rinfo "WARNING: build-essential install failed; native wheel builds may fail."
    else
        rinfo "WARNING: no C compiler and no passwordless sudo/apt — native wheel builds may fail."
    fi
fi

# --- 7b. code-server (standalone, no sudo) ----------------------------
if ! command -v code-server >/dev/null 2>&1; then
    rinfo "Installing code-server (standalone, no sudo)..."
    curl -fsSL https://code-server.dev/install.sh \
        | sh -s -- --method=standalone --prefix="$HOME/.local"
else
    rinfo "code-server already installed: $(command -v code-server)"
fi
command -v code-server >/dev/null 2>&1 || { echo "ERROR: code-server install failed" >&2; exit 1; }

# --- 7c. `code` shim --------------------------------------------------
# install.sh probes `code` to drop the VSIX into the editor.  Forward the
# extension subcommands to code-server so the KISS Sorcar VSIX lands in
# code-server's extensions dir.  A plain ``code <dir>`` launch is
# swallowed — we start code-server ourselves in 7h.
cat > "$HOME/.local/bin/code" <<'SHIM'
#!/bin/bash
case "${1:-}" in
    --install-extension|--uninstall-extension|--list-extensions|--version|--locate-extension)
        exec code-server "$@" ;;
    *)
        exit 0 ;;
esac
SHIM
chmod +x "$HOME/.local/bin/code"

# --- 7d. code-server settings: never block on workspace-trust ---------
# Trust matters beyond the prompt: the extension only honors
# KISS_PROJECT_PATH when vscode.workspace.isTrusted (see kissPaths.ts).
SETTINGS_DIR="$HOME/.local/share/code-server/User"
mkdir -p "$SETTINGS_DIR"
if [ ! -f "$SETTINGS_DIR/settings.json" ]; then
    cat > "$SETTINGS_DIR/settings.json" <<'JSON'
{
    "security.workspace.trust.enabled": false,
    "security.workspace.trust.startupPrompt": "never",
    "security.workspace.trust.banner": "never",
    "security.workspace.trust.emptyWindow": false
}
JSON
fi

# --- 7e. Give the copied tree a real git repo -------------------------
# The VSIX build's copy-kiss.sh enumerates sources with `git ls-files`, and
# other tooling expects a checkout.  The laptop copy is verbatim, so if it
# came from a git *worktree* its ``.git`` is a one-line file pointing at an
# absolute laptop path (".git/worktrees/<name>") that does not exist here —
# every git command in the tree would fail.  Replace such a pointer with a
# self-contained repo.  Without a working `git ls-files` the extension
# ships an EMPTY kiss_project and its `uv sync` fails with
# "file does not exist: src/kiss/core/_version.py".
if ! command -v git >/dev/null 2>&1; then
    echo "ERROR: git is not installed on the remote host; install.sh's VSIX" >&2
    echo "       build needs 'git ls-files'.  Install git and re-run." >&2
    exit 1
fi
NEED_INIT=0
if [ ! -e "$WORKSPACE/.git" ]; then
    NEED_INIT=1
elif ! git -C "$WORKSPACE" rev-parse --git-dir >/dev/null 2>&1; then
    rinfo "$WORKSPACE/.git points outside this machine (git worktree) — replacing it."
    rm -rf "$WORKSPACE/.git"
    NEED_INIT=1
fi
if [ "$NEED_INIT" = "1" ]; then
    rinfo "Initializing a local git repo in $WORKSPACE so 'git ls-files' works..."
    git -C "$WORKSPACE" init -q -b main 2>/dev/null || git -C "$WORKSPACE" init -q
fi
# A repo-LOCAL identity, not just `-c` flags on our own commit: every agent
# task that runs with "Use worktree" enabled commits a baseline in a worktree
# of this repo, and a cloud VM has no global git identity, so those commits
# fail with "Author identity unknown" and the agent silently degrades to
# running without worktree isolation.
git -C "$WORKSPACE" config user.email "sorcar-cloud@local"
git -C "$WORKSPACE" config user.name "sorcar-cloud"
# Stage everything either way: a freshly copied tree needs its first
# commit, and an in-place re-copy (--keep-remote) needs the snapshot
# refreshed so `git ls-files` lists the files that just arrived.
git -C "$WORKSPACE" add -A 2>/dev/null || true
git -C "$WORKSPACE" commit -q -m "sorcar-cloud snapshot" 2>/dev/null || true

# --- 7f. Make sure any .venv here belongs to THIS machine -------------
# Nothing downstream repairs a foreign virtualenv.  install.sh never
# rebuilds the Python environment (it says so itself: "Restarting kiss-web
# is owned entirely by the VS Code extension"), and the extension's
# DependencyInstaller only runs ``uv sync`` when ``.venv`` is ABSENT —
# otherwise it takes the "Fast path: uv and .venv present" branch.  Its one
# safety net, checkPythonVersion(), shells out to ``uv run python
# --version`` with a 30 s timeout and treats every failure as a transient
# 'error' that KEEPS the venv.  So a stale or foreign ``.venv`` is adopted
# forever: imports fail, and ``.venv/bin/kiss-web`` — the ExecStart of the
# kiss-web systemd unit — is missing or carries a laptop shebang.
#
# The copy step already filters ``.venv`` out, so this only fires for a
# venv left behind on the remote (an older deploy, a --keep-remote run, or
# a hand-run install).  Keep it only if it is genuinely usable here:
#   bin/python must EXECUTE   — catches macOS/arm64 trees, dangling
#                               interpreter symlinks and moved homes;
#   bin/kiss-web must EXIST   — catches a half-synced env that would still
#                               satisfy the extension's fast path but leave
#                               the webapp unit with nothing to start.
# Otherwise delete it, so install.sh and the extension build a native one
# from ``uv.lock``.
if [ -d "$WORKSPACE/.venv" ]; then
    if "$WORKSPACE/.venv/bin/python" -c 'pass' >/dev/null 2>&1 \
       && [ -x "$WORKSPACE/.venv/bin/kiss-web" ]; then
        rinfo "Keeping $WORKSPACE/.venv (native and complete on this host)."
    else
        rinfo "Deleting $WORKSPACE/.venv — not usable on this host; it will be rebuilt."
        rm -rf "$WORKSPACE/.venv"
    fi
else
    rinfo "No .venv in $WORKSPACE — it will be built here from uv.lock."
fi

# --- 7g. Run the FULL install.sh --------------------------------------
# KISS_CODE_CLI=code-server routes install.sh's find_code_cli() to
# code-server so the built VSIX lands in the browser IDE's extensions dir.
# KISS_SKIP_LAUNCH=1 stops install.sh from launching a desktop VS Code (or
# a second code-server on the same port) — we start code-server in 7h.
# KISS_SKIP_UPDATE=1 stops its update_repo() from pulling origin/main over
# the tree we just shipped.  That matters when the laptop checkout is a
# plain clone (its .git, and therefore its 'origin', travels verbatim): the
# pull would fast-forward — or on divergence 'reset --hard @{upstream}' —
# the code away from the working directory this script promises to deploy,
# and the auto-stash of the uncommitted edits could fail to re-apply.
rinfo "Running the full install.sh in $WORKSPACE (this can take several minutes)..."
KISS_CODE_CLI=code-server KISS_SKIP_LAUNCH=1 KISS_SKIP_UPDATE=1 \
    bash "$WORKSPACE/install.sh"

# install.sh already calls ``code --install-extension`` through the shim,
# but make sure the VSIX it just built is the one code-server loads.
VSIX="$WORKSPACE/src/kiss/agents/vscode/kiss-sorcar.vsix"
if [ -f "$VSIX" ]; then
    rinfo "Installing KISS Sorcar VSIX into code-server..."
    code-server --install-extension "$VSIX" --force || true
else
    rinfo "WARNING: $VSIX not found — install.sh may have failed to build it."
fi

# --- 7h. Run the IDE as a systemd *user* service ----------------------
# The IDE must outlive this ssh session by a lot: the whole point is that
# tomorrow, from a different laptop, ``sorcar-connect user@host`` finds it
# already listening.  A backgrounded ``setsid code-server`` cannot promise
# that — it dies with the machine, never comes back after a crash, and is
# invisible to systemd — so the IDE gets a real user unit:
#   Restart=always      a crashed or OOM-killed editor comes back by itself;
#   WantedBy=default.target + lingering (enabled below)
#                       the user manager starts it AT BOOT, with nobody
#                       logged in, so a rebooted VM is reachable again;
#   EnvironmentFile     the API keys, from the same file kiss-web uses (the
#                       leading '-' keeps a missing file non-fatal, because
#                       section 6 is skipped when the laptop has no rc with
#                       API_KEY lines);
#   append:             both streams land in the log the operator is already
#                       told to read, ~/.kiss/code-server.log.
# systemd --user is not optional here: the KISS Sorcar extension manages
# kiss-web as a user unit too, so a host without it cannot run KISS at all.
command -v systemctl >/dev/null 2>&1 \
    || { echo "ERROR: systemd (systemctl --user) is required on the remote host." >&2; exit 1; }

# Take down whatever serves this port right now: the unit from an earlier
# deploy, and — with pkill — a detached code-server left by an older
# sorcar-cloud that had no unit.  Stop the unit BEFORE the pkill, or
# Restart=always simply brings it back.
systemctl --user stop "$IDE_SERVICE" 2>/dev/null || true
pkill -f "code-server.*--bind-addr 127.0.0.1:$PORT" 2>/dev/null || true
sleep 1

# code-server remembers the last opened folder in coder.json, and its
# root-URL redirect prefers that memory over the CLI positional argument.
# Point it at the workspace we are about to serve so http://localhost:PORT
# opens the folder we just pushed (not a folder from an older install).
CODER_JSON="$HOME/.local/share/code-server/coder.json"
mkdir -p "$(dirname "$CODER_JSON")"
if command -v python3 >/dev/null 2>&1 && [ -f "$CODER_JSON" ]; then
    WORKSPACE="$WORKSPACE" python3 - "$CODER_JSON" <<'PY' || true
import json, os, sys
path = sys.argv[1]
try:
    with open(path) as f:
        data = json.load(f)
except Exception:
    data = {}
if not isinstance(data, dict):
    data = {}
query = data.setdefault("query", {})
query["folder"] = os.environ["WORKSPACE"]
query.pop("workspace", None)
with open(path, "w") as f:
    json.dump(data, f, indent=2)
PY
else
    printf '{\n  "query": {\n    "folder": "%s"\n  }\n}\n' "$WORKSPACE" > "$CODER_JSON"
fi

rinfo "Installing the $IDE_SERVICE user service (127.0.0.1:$PORT, workspace: $WORKSPACE)..."
# --bind-addr 127.0.0.1: the editor runs with --auth none, so it must never
# be reachable except through an SSH tunnel.  KISS_PROJECT_PATH tells the
# extension which checkout to run (kissPaths.ts findKissProject).  PATH is
# set explicitly because a systemd service inherits nothing from a shell and
# uv / code-server / kiss-web all live in ~/.local/bin.
mkdir -p "$HOME/.config/systemd/user"
CODE_SERVER_BIN="$(command -v code-server)"
cat > "$HOME/.config/systemd/user/$IDE_SERVICE.service" <<UNIT
[Unit]
Description=KISS Sorcar IDE (code-server) on 127.0.0.1:$PORT
Documentation=https://github.com/ksenxx/kiss_ai
After=network-online.target

[Service]
Type=exec
EnvironmentFile=-%h/.kiss/api_keys.systemd.env
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment="KISS_PROJECT_PATH=$WORKSPACE"
WorkingDirectory=$WORKSPACE
ExecStart=$CODE_SERVER_BIN --bind-addr 127.0.0.1:$PORT --auth none --disable-workspace-trust --enable-proposed-api ksenxx.kiss-sorcar "$WORKSPACE"
Restart=always
RestartSec=3
StandardOutput=append:%h/.kiss/code-server.log
StandardError=append:%h/.kiss/code-server.log

[Install]
WantedBy=default.target
UNIT

# Lingering must be on BEFORE ``enable`` is meaningful: without it the user
# manager (and every unit in it, kiss-web included) is killed when this ssh
# session closes and is not started at boot.  The extension enables it too,
# but only once it activates — long after this connection is gone.
if command -v loginctl >/dev/null 2>&1; then
    loginctl enable-linger "$(id -un)" 2>/dev/null || true
fi
systemctl --user daemon-reload
# enable: start at boot.  restart: start now (and replace a running one).
systemctl --user enable "$IDE_SERVICE" >/dev/null 2>&1 \
    || rinfo "WARNING: could not enable $IDE_SERVICE at boot."
# The previous launcher recreated this log on each deploy with a plain '>'
# redirect; ``append:`` would keep growing across every restart, so start the
# deploy's log clean here instead.
: > "$LOG_DIR/code-server.log"
systemctl --user restart "$IDE_SERVICE"

# /healthz is code-server's own unauthenticated liveness route, so it proves
# the editor is serving rather than merely holding the port.
up=0
for _ in $(seq 1 60); do
    if curl -sf "http://127.0.0.1:$PORT/healthz" -o /dev/null 2>/dev/null; then
        up=1; break
    fi
    sleep 1
done
if [ "$up" != "1" ]; then
    echo "ERROR: code-server did not come up on 127.0.0.1:$PORT" >&2
    systemctl --user status "$IDE_SERVICE" --no-pager -l 2>&1 | tail -20 >&2
    tail -20 "$LOG_DIR/code-server.log" 2>/dev/null >&2 || true
    exit 1
fi
rinfo "code-server is up on 127.0.0.1:$PORT (log: ~/.kiss/code-server.log)."

# --- 7i. Record the deployment so ANY machine can find it -------------
# sorcar-connect reads this file over ssh to learn which ports to forward and
# which service to start.  That indirection is what lets a machine which has
# never run sorcar-cloud — and therefore knows neither the port nor the
# workspace path — open this IDE.  It stays on the remote only: the ~/.kiss
# mirror in section 5a excludes it, so a later deploy from a laptop that has
# no such file cannot delete it.
cat > "$HOME/.kiss/sorcar-cloud.env" <<STATE
# Written by sorcar-cloud (deploy at $(date -u '+%Y-%m-%dT%H:%M:%SZ')).
# Read by sorcar-connect, possibly running on a different machine.
# Plain KEY=value shell syntax; no secrets belong here.
SORCAR_IDE_PORT=$PORT
SORCAR_WEB_PORT=$WEB_PORT
SORCAR_WORKSPACE=$WORKSPACE
SORCAR_IDE_SERVICE=$IDE_SERVICE
STATE
chmod 600 "$HOME/.kiss/sorcar-cloud.env"

# NOTE: we deliberately do NOT wait for kiss-web here.  The extension — which
# installs and starts the kiss-web unit — activates only when a real browser
# loads the workbench and runs its JavaScript; a curl of the HTML cannot do
# that.  The wait therefore belongs on the client side, after the tunnel is
# open and a browser has been pointed at the IDE (sorcar-connect does it).
exit 0
REMOTE
info "Remote KISS Sorcar / code-server is ready."

# ---------------------------------------------------------------------------
# 8. Hand over to sorcar-connect: forward the ports, open the browser, hold.
#
# Everything from here on is pure client work — nothing about it depends on
# this being the machine that deployed.  So it lives in ./sorcar-connect,
# which is a single self-contained file you can copy to any host with ssh
# keys.  Running it here (instead of copy-pasting its logic) means the path
# your other machines take is tested on every deploy.
#
# exec, not a call: the connect script becomes this process, so its Ctrl+C
# trap and the tunnel it owns are not wrapped in a parent that could outlive
# them.
# ---------------------------------------------------------------------------
info "Connect from ANY machine that can ssh into $TARGET:"
info "    scp $TARGET:$SCRIPT_BASE/sorcar-connect .   # once"
info "    ./sorcar-connect $TARGET"
if [[ -n "${SORCAR_NO_TUNNEL:-}" ]]; then
    # Lets scripts/CI run the deployment and return without a tunnel.
    info "SORCAR_NO_TUNNEL set — skipping the tunnel and the browser."
    "$CONNECT_SCRIPT" --print "$TARGET" "$PORT"
    exit 0
fi
exec "$CONNECT_SCRIPT" "$TARGET" "$PORT"
