{
  "name": "kiss-sorcar",
  "displayName": "KISS Sorcar",
  "description": "The open-source AI coding agent that beats Cursor and Claude Code on Terminal Bench. Free, local, bring your own API key.",
  "version": "2026.9.21",
  "publisher": "ksenxx",
  "repository": {
    "type": "git",
    "url": "https://github.com/ksenxx/kiss_ai"
  },
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:kissSorcar.chatTab"
  ],
  "icon": "media/thumbnail.jpeg",
  "enabledApiProposals": [
    "contribSourceControlInputBoxMenu"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "KISS Sorcar runs a local Python backend; opt-in API keys and shell tools require trust."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kissSorcarContainer",
          "title": "KISS Sorcar",
          "icon": "media/kiss-icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "kissSorcarSecondary",
          "title": "KISS Sorcar",
          "icon": "media/kiss-icon.svg",
          "order": -100
        }
      ]
    },
    "views": {
      "kissSorcarContainer": [
        {
          "type": "webview",
          "id": "kissSorcar.historyView",
          "name": "History"
        }
      ],
      "kissSorcarSecondary": [
        {
          "type": "webview",
          "id": "kissSorcar.chatViewSecondary",
          "name": "Chat",
          "when": "!config.kissSorcar.editorTabsMode"
        },
        {
          "type": "webview",
          "id": "kissSorcar.metaViewSecondary",
          "name": "Task Info",
          "when": "config.kissSorcar.editorTabsMode"
        }
      ]
    },
    "commands": [
      {
        "command": "kissSorcar.openPanel",
        "title": "KISS: Open Sorcar Chat",
        "icon": {
          "light": "media/kiss-icon.svg",
          "dark": "media/kiss-icon.svg"
        }
      },
      {
        "command": "kissSorcar.newConversation",
        "title": "KISS: New Conversation",
        "icon": "$(add)"
      },
      {
        "command": "kissSorcar.openSettings",
        "title": "KISS: Open Sorcar Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "kissSorcar.stopTask",
        "title": "KISS: Stop Current Task"
      },
      {
        "command": "kissSorcar.generateCommitMessage",
        "title": "KISS: Generate Commit Message",
        "icon": "$(sparkle)"
      },
      {
        "command": "kissSorcar.gitCommit",
        "title": "KISS: Git Commit",
        "icon": "$(git-commit)"
      },
      {
        "command": "kissSorcar.toggleFocus",
        "title": "KISS: Focus Chat"
      },
      {
        "command": "kissSorcar.focusEditor",
        "title": "KISS: Focus Editor"
      },
      {
        "command": "kissSorcar.runSelection",
        "title": "KISS: Run Selection in Chat"
      },
      {
        "command": "kissSorcar.insertSelectionToChat",
        "title": "KISS: Insert Selection into Chat"
      },
      {
        "command": "kissSorcar.showHistory",
        "title": "KISS: Show Chat History",
        "icon": "media/kiss-icon.png"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "kissSorcar.newConversation",
          "group": "navigation@-4",
          "when": "config.kissSorcar.editorTabsMode"
        },
        {
          "command": "kissSorcar.gitCommit",
          "group": "navigation@-3",
          "when": "config.kissSorcar.editorTabsMode"
        },
        {
          "command": "kissSorcar.openSettings",
          "group": "navigation@-2",
          "when": "config.kissSorcar.editorTabsMode"
        },
        {
          "command": "kissSorcar.showHistory",
          "group": "navigation@-1",
          "when": "config.kissSorcar.editorTabsMode"
        }
      ],
      "scm/title": [
        {
          "command": "kissSorcar.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "scm/inputBox": [
        {
          "command": "kissSorcar.generateCommitMessage",
          "when": "scmProvider == git"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kissSorcar.newConversation",
        "key": "ctrl+t",
        "mac": "cmd+t"
      },
      {
        "command": "kissSorcar.toggleFocus",
        "key": "ctrl+d",
        "mac": "cmd+d"
      },
      {
        "command": "kissSorcar.runSelection",
        "key": "ctrl+e",
        "mac": "cmd+e"
      },
      {
        "command": "kissSorcar.insertSelectionToChat",
        "key": "ctrl+l",
        "mac": "cmd+l"
      }
    ],
    "configurationDefaults": {
      "workbench.notifications.position": "bottom-left"
    },
    "configuration": {
      "title": "KISS Sorcar",
      "properties": {
        "kissSorcar.defaultModel": {
          "type": "string",
          "default": "claude-opus-4-6",
          "description": "Default LLM model for new conversations"
        },
        "kissSorcar.kissProjectPath": {
          "type": "string",
          "default": "",
          "description": "Path to KISS project root (auto-detected if empty)"
        },
        "kissSorcar.editorTabsMode": {
          "type": "boolean",
          "default": true,
          "description": "Open each KISS Sorcar chat as an editor tab instead of the secondary-sidebar chat view (toggleable from the chat's settings panel)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run copy-kiss",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "copy-kiss": "bash copy-kiss.sh",
    "package": "node scripts/package-vsix.js --no-dependencies --allow-missing-repository -o kiss-sorcar.vsix",
    "lint": "npm run lint:ts && npm run lint:css && npm run lint:html",
    "lint:ts": "eslint 'src/**/*.ts' 'media/**/*.js' --ignore-pattern 'media/**/*.min.js'",
    "lint:css": "stylelint 'media/**/*.css' --ignore-pattern 'media/**/*.min.css'",
    "lint:html": "htmlhint 'src/**/*.html' 'media/**/*.html' || true",
    "lint:fix": "eslint 'src/**/*.ts' 'media/**/*.js' --ignore-pattern 'media/**/*.min.js' --fix && stylelint 'media/**/*.css' --ignore-pattern 'media/**/*.min.css' --fix",
    "typecheck": "tsc --noEmit -p ./",
    "test": "npm run compile && node test/run-all.js",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "overrides": {
    "encoding-sniffer": "^1.0.2",
    "external-editor": {
      "tmp": "^0.2.7"
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.98.0",
    "@vscode/vsce": "^3.9.2",
    "gts": "^7.0.0",
    "htmlhint": "^1.9.2",
    "jsdom": "^29.1.1",
    "stylelint": "^17.8.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.0.0"
  }
}
