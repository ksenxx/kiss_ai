{
  "name": "kiss-webapp",
  "description": "Browser frontend of KISS Sorcar, served by kiss-web from media/.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ksenxx/kiss_ai"
  },
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint 'media/**/*.js'",
    "lint:css": "stylelint 'media/**/*.css'",
    "lint:html": "htmlhint 'media/**/*.html'",
    "lint:fix": "eslint 'media/**/*.js' --fix && stylelint 'media/**/*.css' --fix",
    "test": "node test/run-all.js",
    "check": "npm run lint && npm run test"
  },
  "overrides": {
    "encoding-sniffer": "^1.0.2",
    "external-editor": {
      "tmp": "^0.2.7"
    }
  },
  "devDependencies": {
    "gts": "^7.0.0",
    "htmlhint": "^1.9.2",
    "jsdom": "^29.1.1",
    "stylelint": "^17.8.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
