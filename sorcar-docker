#!/bin/bash
# Author: Koushik Sen (ksen@berkeley.edu)
# Contributors:
# Koushik Sen (ksen@berkeley.edu)
# add your name here
# Launch KISS Sorcar in a Docker container: the kiss-web daemon and its
# webapp, reached from the host's browser.
#
# Usage:  ./sorcar-docker [PORT] [--rebuild]
#
# Flow:
#   1. Reuse the existing Docker image (kiss-sorcar-web) if present; otherwise
#      build it from ./Dockerfile. Pass --rebuild to force a fresh build.
#   2. Pass git credentials (GH_TOKEN), the webapp password and the model
#      API keys to the container.
#   3. Container clones https://github.com/ksenxx/kiss (or, without a token
#      for it, the public kiss_ai) into the sorcar user's home.
#   4. Container runs the checkout's install.sh (Python env, Playwright,
#      cloudflared) and starts kiss-web on port 8787, serving the checkout.
#   5. Host waits for kiss-web, then opens the browser on it.
#
# The container's state (clone, Python environment, daemon config, task
# history, TLS certificates) lives in the kiss-sorcar-web-home volume, so a
# removed container comes back with its data and a shorter install.
#
# Environment:
#   GH_TOKEN             — GitHub token (auto-detected from `gh auth token`;
#                          optional: without one the public repo is cloned)
#   KISS_WEB_PASSWORD    — webapp password (default: generated on first
#                          start and kept in the volume afterwards)
#   ANTHROPIC_API_KEY    — Anthropic API key (recommended)
#   ANTHROPIC_WORKSPACE_ID — Anthropic workspace id (required when the API
#                          key is identity-linked)
#   OPENAI_API_KEY       — OpenAI API key (optional)
#   GEMINI_API_KEY       — Gemini API key (optional)
#   TOGETHER_API_KEY     — Together API key (optional)
#   OPENROUTER_API_KEY   — OpenRouter API key (optional)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PORT=""
REBUILD=0
for arg in "$@"; do
    case "$arg" in
        --rebuild) REBUILD=1 ;;
        -*) printf '\033[0;31m[ERR]\033[0m  Unknown option: %s\nUsage: %s [PORT] [--rebuild]\n' "$arg" "$0" >&2; exit 1 ;;
        *)
            if [[ -n "$PORT" ]]; then
                printf '\033[0;31m[ERR]\033[0m  Only one PORT may be given (got %s and %s)\nUsage: %s [PORT] [--rebuild]\n' "$PORT" "$arg" "$0" >&2; exit 1
            fi
            # {1,5}-digit cap prevents 64-bit wraparound; 10# forces decimal
            # (otherwise "08" is invalid octal, and the failed arithmetic in
            # an if-condition does not exit under set -e, bypassing the check).
            if ! [[ "$arg" =~ ^[0-9]{1,5}$ ]] || (( 10#$arg < 1 || 10#$arg > 65535 )); then
                printf '\033[0;31m[ERR]\033[0m  Invalid port: %s (expected 1-65535)\nUsage: %s [PORT] [--rebuild]\n' "$arg" "$0" >&2; exit 1
            fi
            PORT="$(( 10#$arg ))" ;;
    esac
done
PORT="${PORT:-8787}"
# The names carry a "-web" suffix so a kiss-sorcar image/container built by the
# old code-server launcher is never reused with this launcher's port and volume.
IMAGE="kiss-sorcar-web"
CONTAINER="kiss-sorcar-web"
VOLUME="kiss-sorcar-web-home"
URL="https://localhost:${PORT}"
MAX_WAIT=900

# ---------------------------------------------------------------------------
# Logging helpers
# ---------------------------------------------------------------------------
info() { printf '\033[0;32m[INFO]\033[0m  %s\n' "$*"; }
step() { printf '\033[0;34m[STEP]\033[0m  %s\n' "$*"; }
warn() { printf '\033[1;33m[WARN]\033[0m  %s\n' "$*"; }
die()  { printf '\033[0;31m[ERR]\033[0m  %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# 1. Pre-flight
# ---------------------------------------------------------------------------
command -v docker &>/dev/null || die "Docker is not installed. Install Docker Desktop first."
docker info &>/dev/null 2>&1  || die "Docker daemon is not running. Start Docker and retry."

# ---------------------------------------------------------------------------
# 2. Git credentials — the container clones the private repo with them and
#    falls back to the public one without
# ---------------------------------------------------------------------------
if [[ -z "${GH_TOKEN:-}" ]]; then
    if command -v gh &>/dev/null && gh auth status &>/dev/null 2>&1; then
        GH_TOKEN="$(gh auth token 2>/dev/null || true)"
    fi
fi
if [[ -n "${GH_TOKEN:-}" ]]; then
    info "GitHub token acquired"
else
    warn "No GitHub token (gh auth login / export GH_TOKEN): the container clones the public kiss_ai repo"
fi

# ---------------------------------------------------------------------------
# 3. Build Docker image (reuse the existing one unless --rebuild is given)
# ---------------------------------------------------------------------------
if (( ! REBUILD )) && docker image inspect "$IMAGE" &>/dev/null; then
    info "Reusing existing image '$IMAGE' (pass --rebuild to build a fresh one)"
else
    step "Building Docker image '$IMAGE'..."
    docker build -t "$IMAGE" "$SCRIPT_DIR" 2>&1
fi

# ---------------------------------------------------------------------------
# 4. Remove old container
# ---------------------------------------------------------------------------
if docker ps -a --format '{{.Names}}' | grep -qx "$CONTAINER"; then
    step "Removing old container '$CONTAINER'..."
    docker rm -f "$CONTAINER" >/dev/null
fi

# ---------------------------------------------------------------------------
# 5. Collect environment variables (git credentials, password, API keys)
# ---------------------------------------------------------------------------
ENV_ARGS=()
for key in GH_TOKEN KISS_WEB_PASSWORD ANTHROPIC_API_KEY ANTHROPIC_WORKSPACE_ID OPENAI_API_KEY GEMINI_API_KEY TOGETHER_API_KEY OPENROUTER_API_KEY; do
    [[ -n "${!key:-}" ]] && ENV_ARGS+=(-e "${key}=${!key}")
done

# ---------------------------------------------------------------------------
# 6. Start container
# ---------------------------------------------------------------------------
step "Starting container '$CONTAINER' on port $PORT..."
docker run -d \
    --name "$CONTAINER" \
    -p "${PORT}:8787" \
    -v "${VOLUME}:/home/sorcar" \
    "${ENV_ARGS[@]}" \
    "$IMAGE" >/dev/null

info "Container started"
info "First start clones the repo and runs install.sh — this takes a few minutes."
info "Watch progress: docker logs -f $CONTAINER"

# ---------------------------------------------------------------------------
# 7. Wait for kiss-web to respond.  Its certificate is signed by a CA the
#    container generated, so the probe skips verification (-k).
# ---------------------------------------------------------------------------
for i in $(seq 1 "$MAX_WAIT"); do
    if curl -ksf "$URL" -o /dev/null 2>/dev/null; then
        break
    fi
    if ! docker ps --format '{{.Names}}' | grep -qx "$CONTAINER"; then
        echo ""
        die "Container exited unexpectedly. Run: docker logs $CONTAINER"
    fi
    if (( i % 30 == 0 )); then
        info "Still waiting... (${i}s elapsed)"
    fi
    sleep 1
done

if ! curl -ksf "$URL" -o /dev/null 2>/dev/null; then
    die "Timed out after ${MAX_WAIT}s. Run: docker logs $CONTAINER"
fi

# ---------------------------------------------------------------------------
# 8. Open browser.  The password is whatever the entrypoint reported: the
#    one passed in, else the one kept in the volume, else a generated one.
# ---------------------------------------------------------------------------
PASSWORD="$(docker logs "$CONTAINER" 2>&1 | sed -n 's/.*Webapp password: //p' | tail -1)"
info "KISS Sorcar is ready at $URL"
info "Webapp password: ${PASSWORD:-see 'docker logs $CONTAINER'}"
info "The certificate is self-signed: accept the browser warning once, or install $URL/ca.crt"
case "$(uname -s)" in
    Darwin) open "$URL" ;;
    Linux)  command -v xdg-open &>/dev/null && xdg-open "$URL" & ;;
esac

echo ""
echo "  ┌──────────────────────────────────────────────────┐"
echo "  │  KISS Sorcar: ${URL}"
echo "  │  Password:    ${PASSWORD:-see docker logs}"
echo "  │  Stop:   docker stop ${CONTAINER}"
echo "  │  Remove: docker rm   ${CONTAINER}"
echo "  │  Logs:   docker logs -f ${CONTAINER}"
echo "  └──────────────────────────────────────────────────┘"
